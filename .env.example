# Google Maps API Keys
# バックエンド用（Routes API, Geocoding API）
GOOGLE_MAPS_API_KEY=your_backend_api_key_here

# フロントエンド用（Maps JavaScript API）
VITE_GOOGLE_MAPS_API_KEY=your_frontend_api_key_here

# 駅すぱあと API Key
# 日本国内のTRANSIT検索に使用
# APIキー取得: https://docs.ekispert.com/ から無料アカウント登録
# フリープラン（90日評価版）で全機能をテスト可能
EKISPERT_API_KEY=your_ekispert_api_key_here

# バックエンドサーバー設定
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# フロントエンド設定
VITE_API_BASE_URL=http://localhost:8000
